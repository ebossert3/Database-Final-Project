
SELECT 'CREATE TABLES' FROM DUAL;
--Strong Entity
CREATE TABLE DEPARTMENT (
    department_id VARCHAR(8) NOT NULL PRIMARY KEY,
    department_name VARCHAR(30)
);
--Strong Entitiy
CREATE TABLE PROFESSOR (
    professor_id VARCHAR(8) NOT NULL PRIMARY KEY,
    department_id VARCHAR(8),
    first_name VARCHAR(20),
    last_name VARCHAR(30),
    email VARCHAR(50),
    FOREIGN KEY (department_id) REFERENCES DEPARTMENT (department_id)
);
--Strong Entity
CREATE TABLE STUDENT (
    student_id VARCHAR(8) NOT NULL PRIMARY KEY,
    first_name VARCHAR(20),
    last_name VARCHAR(30),
    email VARCHAR(50) UNIQUE
);
--Strong Entitiy
CREATE TABLE COURSE (
    course_id VARCHAR(8) NOT NULL PRIMARY KEY,
    professor_id VARCHAR(8),
    department_id VARCHAR(8),
    course_no VARCHAR(7),
    course_name VARCHAR(50),
    semester VARCHAR(10),
    year VARCHAR(4),
    FOREIGN KEY (professor_id) REFERENCES PROFESSOR (professor_id),
    FOREIGN KEY (department_id) REFERENCES DEPARTMENT (department_id)
);

--Relates Students to Courses M:N
CREATE TABLE ENROLLMENT (
    enrollment_id VARCHAR(8) NOT NULL PRIMARY KEY,
    student_id VARCHAR(8) NOT NULL,
    course_id VARCHAR(8) NOT NULL,
    FOREIGN KEY (student_id) REFERENCES STUDENT (student_id),
    FOREIGN KEY (course_id) REFERENCES COURSE (course_id)
    --CONSTRAINT UNIQUE (student_id, course_id)
);

--from course 1:N
CREATE TABLE GRADE_CATEGORY (
    category_id VARCHAR(8) NOT NULL PRIMARY KEY,
    course_id VARCHAR(8) NOT NULL,
    category_name VARCHAR(30),
    weight_percent DECIMAL(5,2),
    FOREIGN KEY (course_id) REFERENCES COURSE (course_id)
);
--from grade category 1:N
CREATE TABLE ASSIGNMENT (
    assignment_id VARCHAR(8) NOT NULL PRIMARY KEY,
    category_id VARCHAR(8) NOT NULL,
    title VARCHAR(50),
    max_points DECIMAL(6,2),
    due_date DATE NULL,
    FOREIGN KEY (category_id) REFERENCES GRADE_CATEGORY (category_id)
);
--Relates Students to Assignments M:N
CREATE TABLE SUBMISSION (
    submission_id VARCHAR(8) NOT NULL PRIMARY KEY,
    assignment_id VARCHAR(8) NOT NULL,
    student_id VARCHAR(8) NOT NULL,
    submitted_at DATE,
    FOREIGN KEY (assignment_id) REFERENCES ASSIGNMENT (assignment_id),
    FOREIGN KEY (student_id) REFERENCES STUDENT (student_id)
);
--from submission 1:1
CREATE TABLE GRADE (
    grade_id VARCHAR(8) NOT NULL PRIMARY KEY,
    submission_id VARCHAR(8) NOT NULL UNIQUE,
    points_earned DECIMAL(6,2),
    FOREIGN KEY (submission_id) REFERENCES SUBMISSION (submission_id)
);



-- ADD MISSING CONSTRAINTS

-- 1. Prevent duplicate enrollments
ALTER TABLE ENROLLMENT
ADD CONSTRAINT uq_enrollment UNIQUE (student_id, course_id);


-- 2. Prevent duplicate submissions per assignment
ALTER TABLE SUBMISSION
ADD CONSTRAINT uq_submission UNIQUE (assignment_id, student_id);


-- 3. Ensure valid grade values
ALTER TABLE GRADE
ADD CONSTRAINT chk_points
CHECK (points_earned >= 0);


-- 4. Ensure valid assignment max points
ALTER TABLE ASSIGNMENT
ADD CONSTRAINT chk_max_points
CHECK (max_points > 0);


-- 5. Ensure valid category weights
ALTER TABLE GRADE_CATEGORY
ADD CONSTRAINT chk_weight
CHECK (weight_percent > 0 AND weight_percent <= 100);

--Trigger for grade_category
CREATE OR REPLACE TRIGGER trg_check_category_weight
AFTER INSERT OR UPDATE OR DELETE ON GRADE_CATEGORY
DECLARE
    total_weight NUMBER(6,2);
BEGIN
    FOR rec IN (SELECT DISTINCT course_id FROM GRADE_CATEGORY) LOOP
        SELECT NVL(SUM(weight_percent), 0)
        INTO total_weight
        FROM GRADE_CATEGORY
        WHERE course_id = rec.course_id;

        IF total_weight > 100 THEN
            RAISE_APPLICATION_ERROR(
                -20001,
                'Total weight_percent exceeds 100% for a course'
            );
        END IF;
    END LOOP;
END;
/

